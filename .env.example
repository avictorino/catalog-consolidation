# Copy to .env. Every CLI option has its default here.
# Precedence: CLI argument > .env. Missing values invalidate the run.

CATALOG_URL=https://engineering-hiring-process.s3.us-east-1.amazonaws.com/catalog.db
PRODUCTS_URL=https://engineering-hiring-process.s3.us-east-1.amazonaws.com/ProductEntry.json
OUTPUT=catalog_output.db
# Seller-feed byte-stream transport: http (requests) or s3 (boto3, unsigned
# get_object). Only affects PRODUCTS_URL; the catalog is always fetched over HTTP.
# For s3, PRODUCTS_URL may be s3://bucket/key or an amazonaws.com URL (rewritten).
SOURCE=s3 #http
MATCHER=rapidfuzz #difflib
# Fuzzy cutoff, a float in [0, 1]. Not a CLI option: the similarity backend reads
# THRESHOLD from this file directly, lazily, the first time it is needed. Optional
# — falls back to the backend's suggested_threshold (0.90) if unset or removed.
THRESHOLD=0.90
