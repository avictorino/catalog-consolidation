# Copy to .env. Every CLI option has its default here.
# Precedence: CLI argument > .env. Missing values invalidate the run.

CATALOG_URL=https://engineering-hiring-process.s3.us-east-1.amazonaws.com/catalog.db
PRODUCTS_URL=https://engineering-hiring-process.s3.us-east-1.amazonaws.com/ProductEntry.json
OUTPUT=catalog_output.db
# Byte-stream transport for both URLs: http (requests) or s3 (boto3, unsigned
# get_object). For s3, point the URLs at s3://bucket/key or the amazonaws.com host.
SOURCE=http
MATCHER=rapidfuzz
THRESHOLD=0.90
